         if (ui.focus == Focus::GameList) {
@@ -890,6 +918,30 @@ void drawPopup(Canvas& fb) {
     }
 }

+void drawSyncPopup(Canvas& fb) {
+    if (syncPopupTimer <= 0) return;
+    syncPopupTimer--;
+
+    const int w = 500;
+    const int h = 120;
+    const int x = (fb.w - w) / 2;
+    const int y = (fb.h - h) / 2;
+
+    fb.fillRect(x, y, w, h, 0xFF1A1A25);
+    fb.rect(x, y, w, h, syncPopupSuccess ? 0xFF4ADE80 : 0xFFF87171);
+    fb.text(x + 20, y + 30, syncPopupText.c_str(), 0xFFE8E8ED, 1.1f);
+    fb.text(x + 20, y + 70, syncPopupSuccess ? "Sucesso!" : "Erro", syncPopupSuccess ? 0xFF4ADE80 : 0xFFF87171, 0.9f);
+}
+
 void drawDebug(Canvas& fb) {
     // ... existing debug code ...
 }
@@ -950,6 +992,12 @@ void drawFrame(Canvas& fb) {
     if (ui.showDebug) drawDebug(fb);
     if (ui.showConfirm) drawConfirm(fb);
     if (ui.showUpdate) drawUpdate(fb);
+    if (syncPopupTimer > 0) drawSyncPopup(fb);
+    if (showSyncSettings) {
+        if (!trophynx::sync_ui::drawSettingsScreen(fb, 0, 0)) {
+            showSyncSettings = false;
+        }
+    }
+    if (ui.showCaptures) drawCaptures(fb);
 }
@@ -960,6 +1008,18 @@ void handleInput(u64 keysDown, u64 keysHeld) {
     if (ui.showDebug) { /* ... */ }
